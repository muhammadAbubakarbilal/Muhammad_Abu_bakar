# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3100"

# Public identity. Confirm email before publication; rebuild after changes.
NEXT_PUBLIC_CONTACT_EMAIL="abgakhar787@gmail.com"
NEXT_PUBLIC_SITE_URL="https://abubakarbilal.netlify.app"

# Optional inquiry delivery. Without this, visitors prepare and send an email draft.
# Receiver must accept JSON POST; a 2xx response means it accepted the inquiry.
CONTACT_WEBHOOK_URL=""
CONTACT_WEBHOOK_TOKEN=""
